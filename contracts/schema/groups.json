{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1",
  "schemaVersion": 1,
  "x-ungroupedId": "ungrouped",
  "title": "Groups",
  "type": "object",
  "required": ["schemaVersion", "groups", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "itemIds"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "itemIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
